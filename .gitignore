#.vscode/

# Local secrets passed to the app via --dart-define-from-file. Never commit
# your real OpenAI key.
env.json

# Backend secrets (OpenAI key etc.) loaded via python-dotenv. Never commit.
luna_backend/.env

# Firebase service account key (Admin SDK credentials). Never commit.
luna_backend/firebase_config/serviceAccountKey.json

