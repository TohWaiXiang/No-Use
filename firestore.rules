rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Yoga video-id overrides (config/yoga_videos): app reads only, edited
    // via the Firebase console so an unavailable video can be swapped
    // without an app release.
    match /config/yoga_videos {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
